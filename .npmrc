# electron-builder resolves the Castlabs build from node_modules/electron/dist via
# electronDist in electron-builder.yml, so no download mirror is needed here.
save-exact=true

# Electron is installed from the Castlabs GitHub repo (see devDependencies), and npm 12
# defaults to allow-git=none, which fails the install with EALLOWGIT. `root` permits git
# dependencies declared in this package.json only, never transitive ones.
allow-git=root
