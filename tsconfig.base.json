{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* Strictness. The four below `strict` are deliberate, not decoration. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* The settings store is keyed access everywhere — this is the highest-value flag here. */
    "noUncheckedIndexedAccess": true,
    /* v0.7.x depended on `undefined` vs absent meaning different things (settings.js:14 vs :16). */
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,

    "forceConsistentCasingInFileNames": true,

    /* Must mirror the aliases in electron.vite.config.ts and vitest.config.ts. */
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/*"]
    }
  }
}
