{
  "name": "bettersoundcloud",
  "version": "2.0.0-alpha.0",
  "description": "BetterSoundCloud — a desktop client for SoundCloud",
  "author": "AlirezaKJ",
  "license": "MIT",
  "repository": "https://github.com/AlirezaKJ/BetterSoundCloud",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run check && electron-vite build",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json && svelte-check --tsconfig tsconfig.web.json && eslint . && prettier --check .",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.19.0",
    "electron": "https://github.com/castlabs/electron-releases#v43.2.0+wvcus",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
