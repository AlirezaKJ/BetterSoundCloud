{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // No DOM here on purpose. The main process has no `document`, and letting it
    // typecheck as though it did would turn a compile error into a runtime crash.
    // Preload is the hybrid case and gets its own project — tsconfig.preload.json.
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./node_modules/.tmp/tsconfig.node"
  }
}
